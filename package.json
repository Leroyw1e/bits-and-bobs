{
  "name": "bits-and-bobs",
  "version": "1.19.0",
  "description": "Obsidian plugin: drawing boards, slides, Excel spreadsheets and maths tools.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -p . && node esbuild.config.mjs",
    "check": "tsc -p .",
    "lint": "eslint .",
    "build:web": "esbuild web/sharepage.ts --bundle --minify --format=iife --target=es2020 --outfile=web/dist/share.client.js"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.14.4",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "@types/diff": "^7.0.2",
    "@types/nspell": "^2.1.6",
    "diff": "^9.0.0",
    "nspell": "^2.1.5",
    "perfect-freehand": "^1.2.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "private": true
}
